{
  "schema": "hinet-credential-policy-v1",
  "canonical_path": "/root/.config/equake/credentials/hinet.env",
  "environment_pointer": "HINET_ENV_FILE",
  "required_directory_mode": "0700",
  "required_file_mode": "0600",
  "required_owner": "root:root",
  "forbidden_storage_prefixes": [
    "/workspace/equake",
    "/workspace/google-drive",
    "gdrive:workspace/equake"
  ],
  "allowed_supply_channels": [
    "RunPod secret environment",
    "authenticated SSH standard input from the user side"
  ],
  "forbidden_supply_channels": [
    "command-line credential values",
    "workspace files",
    "Google Drive files",
    "shell history",
    "logs",
    "backups"
  ],
  "secret_value_hashing_allowed": false,
  "atomic_create_required": true,
  "implicit_overwrite_allowed": false,
  "uid_65534_must_be_unreadable": true,
  "missing_credential_behavior": "fail_closed",
  "live_regression": "authenticated read-only NIED Hi-net event search with no local catalog output",
  "protected_scope": [
    "ports 10101/10201/10202",
    "databases",
    "waveforms",
    "analysis jobs"
  ]
}
